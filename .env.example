# Pit Wall — environment template. Copy to `.env` and fill what you have.
# EVERYTHING runs in fully-simulated mode with NO keys set. Keys only upgrade
# individual adapters (LLM, x402 settlement, voice) from mock -> live.
# NEVER commit a real .env.

# ---------------------------------------------------------------------------
# Database (local TimescaleDB via `docker compose up`)
# ---------------------------------------------------------------------------
PITWALL_DB_HOST=localhost
PITWALL_DB_PORT=5432
PITWALL_DB_NAME=pitwall
# Superuser — migrations + role creation only. App code never uses this.
PITWALL_DB_SUPERUSER=postgres
PITWALL_DB_SUPERUSER_PASSWORD=pitwall_dev

# Least-privilege role passwords (roles are created by the migration).
PITWALL_AGENT_DB_PASSWORD=agent_dev
PITWALL_GATEWAY_DB_PASSWORD=gateway_dev
PITWALL_SYNC_DB_PASSWORD=sync_dev
PITWALL_VOICE_DB_PASSWORD=voice_dev

# Optional: point at Tiger Cloud instead of local docker. If set, this URL is
# used for migrations/superuser work (role URLs are derived from it).
# PITWALL_DATABASE_URL=postgres://tsdbadmin:PASS@HOST.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# ---------------------------------------------------------------------------
# World generation (deterministic)
# ---------------------------------------------------------------------------
PITWALL_SEED=1313
# demo = fast, few thousand rows. big = pads time-series into the millions for
# the Tiger Data performance story (slower to generate).
PITWALL_SCALE=demo

# ---------------------------------------------------------------------------
# Agent (M2). Leave ANTHROPIC_API_KEY empty to run the deterministic mock LLM.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
PITWALL_AGENT_MODEL=claude-sonnet-4-6
PITWALL_LLM_MODE=auto            # auto | mock | live  (auto = live iff key present)
PITWALL_AGENT_DAILY_EVIDENCE_BUDGET_USDC=5.00
PITWALL_APPROVAL_THRESHOLD_USDC=250000   # payments above this route to the CFO

# ---------------------------------------------------------------------------
# Coinbase x402 / CDP (M3). Empty = mock settlement (clearly-labeled SIMULATED
# tx hashes). Fill to settle real testnet USDC on Base Sepolia.
# ---------------------------------------------------------------------------
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
PITWALL_X402_MODE=mock           # mock | testnet
PITWALL_X402_NETWORK=base-sepolia
PITWALL_SELLERS_URL=http://localhost:4021

# ---------------------------------------------------------------------------
# Voice (M7). Empty = voice disabled. The core demo never depends on these.
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CARTESIA_API_KEY=
